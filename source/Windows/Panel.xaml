<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="codeusagemonit" Width="420" Height="790" MinWidth="360" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="#F2F3F5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Palette: neutral ink on smoked glass; one cool accent; provider colours only in data. -->
    <SolidColorBrush x:Key="Ink" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="InkDim" Color="#A7ADB7"/>
    <SolidColorBrush x:Key="InkFaint" Color="#7D838D"/>
    <SolidColorBrush x:Key="Accent" Color="#5CC8E0"/>
    <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF"/>

    <!-- Default button: quiet text button used for links and inline actions. -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#D9DCE1"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
          <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" CornerRadius="7"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.03"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#A7ADB7"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#A7ADB7"/><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#12FFFFFF"/><Setter Property="BorderBrush" Value="#1CFFFFFF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#E6E8EB"/><Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#E9EBEE"/><Setter Property="Foreground" Value="#15171B"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,6"/>
    </Style>
    <!-- Provider strip tab: background is set by code (selected), hover is an overlay. -->
    <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="2,7,2,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Toggle switch used by settings. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="#1FFFFFFF" BorderBrush="#2BFFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#C4C8CE" HorizontalAlignment="Left" Margin="3,0"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#45FFFFFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="#5CC8E0"/><Setter TargetName="Track" Property="BorderBrush" Value="#5CC8E0"/>
            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="#0E1417"/>
            <Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Pill toggle for provider selection. -->
    <Style x:Key="Chip" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#A7ADB7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Pill" CornerRadius="15" Padding="10,5,12,5" Background="Transparent" BorderBrush="#24FFFFFF" BorderThickness="1">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="#40FFFFFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Pill" Property="Background" Value="#1A5CC8E0"/><Setter TargetName="Pill" Property="BorderBrush" Value="#995CC8E0"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Segment of a segmented control (RadioButtons inside a rounded well). -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A7ADB7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Seg" CornerRadius="6" Padding="10,5" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seg" Property="Background" Value="#0DFFFFFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Seg" Property="Background" Value="#26FFFFFF"/><Setter Property="Foreground" Value="#F2F3F5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="CaretBrush" Value="#F2F3F5"/><Setter Property="SelectionBrush" Value="#5CC8E0"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Box" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#33FFFFFF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#5CC8E0"/><Setter TargetName="Box" Property="Background" Value="#14FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="CaretBrush" Value="#F2F3F5"/><Setter Property="SelectionBrush" Value="#5CC8E0"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="Box" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#33FFFFFF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#5CC8E0"/><Setter TargetName="Box" Property="Background" Value="#14FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="#5CC8E0" VerticalAlignment="Center"/></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="22" Background="Transparent">
          <Border Height="4" CornerRadius="2" Background="#24FFFFFF" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Ellipse x:Name="Dot" Width="14" Height="14" Fill="#F2F3F5" Stroke="#40000000" StrokeThickness="1"/>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/></Grid.ColumnDefinitions>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Width="6"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="#2EFFFFFF" CornerRadius="2" Margin="1.5,2"/>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#55FFFFFF"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      </Track>
    </ControlTemplate></Setter.Value></Setter></Style>

    <!-- Dark context menu (desktop widgets). Flat: no submenus. -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Foreground" Value="#ECEEF1"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="#F51F2126" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="4">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Foreground" Value="#ECEEF1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Bg" CornerRadius="5" Padding="8,6,16,6" Background="Transparent" MinWidth="148">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#5CC8E0" Visibility="Hidden" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#1FFFFFFF" Margin="8,4"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="HasDropShadow" Value="False"/><Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="#E6E8EB"/><Setter Property="Placement" Value="Mouse"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="#F21E2126" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="290">
          <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="17"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Surface" Background="#A815171B" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8">
   <Grid>
    <!-- Optional background picture and its dimming layer (see Appearance.cs). -->
    <Border x:Name="BackdropImage" CornerRadius="7" Visibility="Collapsed"/>
    <Border x:Name="BackdropScrim" CornerRadius="7" Visibility="Collapsed"/>
    <!-- Small / medium / large display sizes render here; ScaleRoot is the full panel. -->
    <Border x:Name="CompactRoot" Visibility="Collapsed" Background="Transparent"/>
    <Grid x:Name="ScaleRoot">
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

      <!-- Header: drag to move (DragMove), right-click for display sizes. -->
      <Grid x:Name="TitleArea" Background="Transparent" Margin="14,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <Grid x:Name="Logo" Width="13" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
            <Border Width="3" Height="7" Background="#6DE0D6" CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
            <Border Width="3" Height="14" Background="#96D9EE" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            <Border Width="3" Height="10" Background="#D6C1F9" CornerRadius="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBlock x:Name="TitleText" Text="codeusagemonit" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border x:Name="DemoBadge" Visibility="Collapsed" Margin="8,0,0,0" Padding="6,1,6,2" CornerRadius="4" Background="#1A5CC8E0" VerticalAlignment="Center">
            <TextBlock Text="演示" FontSize="10" Foreground="#5CC8E0"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" ToolTip="刷新（F5）" AutomationProperties.Name="刷新额度">
            <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock>
          </Button>
          <Button x:Name="SizeButton" Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="显示尺寸（小 / 中 / 大 / 完整）" AutomationProperties.Name="显示尺寸"/>
          <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" AutomationProperties.Name="固定面板"/>
          <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置"/>
          <Button x:Name="HideButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10.5" ToolTip="收起到托盘（Esc）" AutomationProperties.Name="收起面板"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="TabHost" Grid.Row="1" Margin="10,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid x:Name="Tabs" Rows="1"/>
        <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="4,8,4,0"/>
      </Grid>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0" Padding="14,12,8,6" CanContentScroll="False"><StackPanel x:Name="Body"/></ScrollViewer>
      </Grid>

      <Grid Grid.Row="3" Margin="16,0,14,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Height="1" Background="#10FFFFFF" VerticalAlignment="Top" Margin="-2,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#7AD3A8" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="#8A909A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock x:Name="ScaleText" Grid.Column="1" FontSize="10.5" Foreground="#6F757F" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </Grid>
    </Grid>
   </Grid>
  </Border>
</Window>
